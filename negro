                    if not myPlot then myPlot = getMyPlot() end
                    local hrp = getHRP()
                    if myPlot and hrp then
                        local old = hrp.CFrame
                        for _, d in ipairs(myPlot:GetDescendants()) do
                            if not autoOpenCases then break end
                            if d:IsA("ProximityPrompt") and d.Enabled and d.ActionText ~= "Sell" and d.ActionText ~= "Remove" then
                                hrp.CFrame = d.Parent.CFrame * CFrame.new(0, 3, 0)
                                task.wait(0.3)
                                safePrompt(d)
                                task.wait(0.2)
                            end
                        end
                        hrp.CFrame = old
                    end
                    task.wait(0.5)
                end
            end)
        end
    end
})

-- // RECONFIGURED: Equip Best Knives \\
PlotTab:CreateButton({
    Name = "Equip Best Knives",
    Info = "Equips the highest earning knives",
    Callback = function()
        local slotsFolder = myPlot.Plot_Models.BaseModel:FindFirstChild("Slots")
        local hrp = getHRP()
        local hum = getHum()
        if not slotsFolder or not hrp or not hum then return end
        
        local oldPos = hrp.CFrame
        local placedCount = 0

        for _, slot in pairs(slotsFolder:GetChildren()) do
            local standPart = slot:FindFirstChild("StandPart")
            local prompt = standPart and standPart:FindFirstChild("ProximityPrompt")

            if prompt and prompt.ActionText == "Place" then
                local hasCaseModel = false
                if slot:FindFirstChild("StandModel") then
                    for _, child in pairs(slot.StandModel:GetChildren()) do
                        if string.find(string.lower(child.Name), "case") or string.find(string.lower(child.Name), "chest") then
                            hasCaseModel = true
                            break
                        end
                    end
                end

                if not hasCaseModel then
                    local knifeToUse = findCurrentBest() 
                    if knifeToUse then
                        hum:EquipTool(knifeToUse)
                        task.wait(0.1)
                        hrp.CFrame = standPart.CFrame * CFrame.new(0, 3, 0)
                        task.wait(0.12) 
                        
                        local attempts = 0
                        while (prompt.ActionText ~= "Remove" and prompt.ActionText ~= "Open") and attempts < 5 do
                            safePrompt(prompt)
                            task.wait(0.2)
                            attempts = attempts + 1
                        end
                        placedCount = placedCount + 1
                    else
                        break 
                    end
                end
            end
        end
        hrp.CFrame = oldPos
        Rayfield:Notify({Title = "Stands Updated", Content = "Filled " .. placedCount .. " empty stands while ignoring all chests.", Duration = 5, Image = "shield-check"})
    end,
})

-- // RECONFIGURED: Remove All Knives \\
PlotTab:CreateButton({
    Name = "Remove All Knives",
    Info = "Removes all knives from the plot",
    Callback = function()
        local slotsFolder = myPlot.Plot_Models.BaseModel:FindFirstChild("Slots")
        local hrp = getHRP()
        if not slotsFolder or not hrp then return end

        local oldPos = hrp.CFrame
        local totalRemoved = 0

        for _, slot in pairs(slotsFolder:GetChildren()) do
            local standPart = slot:FindFirstChild("StandPart")
            local prompt = standPart and standPart:FindFirstChild("ProximityPrompt")
            
            if prompt and prompt.ActionText == "Remove" then
                hrp.CFrame = standPart.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.1) 
                local attempts = 0
                while prompt.ActionText == "Remove" and attempts < 10 do
                    safePrompt(prompt)
                    task.wait(0.15)
                    attempts = attempts + 1
                end
                if prompt.ActionText ~= "Remove" then totalRemoved = totalRemoved + 1 end
            end
        end
        hrp.CFrame = oldPos 
        Rayfield:Notify({Title = "Cleaning Complete", Content = "Confirmed removal of " .. totalRemoved .. " knives.", Duration = 3, Image = "check-circle"})
    end,
})

