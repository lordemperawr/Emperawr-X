EcoTab:CreateSection("💰 Profit Loop")
EcoTab:CreateToggle({
    Name = "Master Profit Loop",
    CurrentValue = false,
    Callback = function(Value)
        autoSellEnabled = Value
        if autoSellEnabled then
            task.spawn(function()
                while autoSellEnabled do
                    local hrp = getHRP()
                    local hum = getHum()
                    if hrp and myPlot then
                        local returnPos = hrp.CFrame
                        hrp.CFrame = myPlot.Plot_Models.BaseModel.BoxStand.CFrame * CFrame.new(0, 3, 0)
                        task.wait(0.5)
                        local bp = myPlot.Plot_Models.BaseModel.BoxStand:FindFirstChildOfClass("ProximityPrompt")
                        if bp then safePrompt(bp) end
                        task.wait(0.4)
                        
                        local sellPart = myPlot.Plot_Models.BaseModel.SellButton.SellP
                        hrp.CFrame = sellPart.CFrame * CFrame.new(0, 3.2, 0)
                        
                        task.wait(0.1)
                        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
                        
                        task.wait(1.4) 
                        if autoSellInventory then sellInventoryItems() end
                        task.wait(0.5)
                        hrp.CFrame = returnPos
                    end
                    local timeLeft = sellInterval
                    while timeLeft > 0 and autoSellEnabled do
                        SellTimerLabel:Set(string.format("⏳ Next Sell In: %02d:%02d", math.floor(timeLeft/60), timeLeft%60))
                        task.wait(1)
                        timeLeft = timeLeft - 1
                    end
                end
                SellTimerLabel:Set("⏳ Next Sell In: --:--")
            end)
        end
    end,
})

