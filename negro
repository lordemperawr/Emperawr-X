-- // Plot Detection \\
local myPlot = nil
local function getMyPlot()
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return nil end
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        local ownerAttr = plot:GetAttribute("Owner") or plot:GetAttribute("Player")
        if ownerAttr == LocalPlayer.Name or ownerAttr == LocalPlayer.UserId then return plot end
    end
    return nil
end
myPlot = getMyPlot()

local function isMatch(selectedTable, value)
    if not value or value == "" or not selectedTable then return false end
    for k, v in pairs(selectedTable) do
        local target = tostring(type(k) == "string" and k or v):lower()
        if string.find(string.lower(value), target) then return true end
    end
    return false
end

-- // NEW LOGIC HELPERS \\
local function findCurrentBest()
    local best, high = nil, -1
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") and not item:FindFirstChildOfClass("Model") then
            local val = 0 
            local bill = item:FindFirstChild("BillboardGui", true)
            if bill and bill:FindFirstChild("GivingAmount") then
                val = tonumber(bill.GivingAmount.Text:gsub("[$,/knife%s]", "")) or 0
            end
            if val > high then high = val best = item end
        end
    end
    return best
end

local function findMatchingChest()
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            local modelChild = item:FindFirstChildOfClass("Model")
            if modelChild and isMatch(selectedChestRarities, modelChild.Name) then
                return item
            end
        end
    end
    return nil
end

function sellInventoryItems()
    local hum = getHum()
    if not hum then return end
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            local mutLabel = item:FindFirstChild("EventRarity", true)
            if mutLabel and mutLabel.Text ~= "" and isMatch(selectedMutationRarity, mutLabel.Text) then continue end
            
            local modelChild = item:FindFirstChildOfClass("Model")
            local rarityLabel = item:FindFirstChild("RarityText", true) or item:FindFirstChild("Rarity", true)
            
            if (modelChild and isMatch(sellCaseRarities, modelChild.Name)) or (rarityLabel and isMatch(sellKnifeRarities, rarityLabel.Text)) then
                hum:EquipTool(item)
                task.wait(0.15)
                sellThisRemote:FireServer()
                task.wait(0.1)
            end
        end
    end
end

